# Copy to .env and fill in real values.
#
# NOTE: several of these were missing from this file entirely. That is worth
# fixing on its own — the code checks for a variable and does nothing when it
# is absent, and absent is indistinguishable from "deliberately disabled", so
# nothing ever reports a problem.
#
# It did NOT mean analytics was off in production, which an earlier version of
# this note claimed. Vercel has held these since 14 July and the live site
# loads gtag correctly. Only NEXT_PUBLIC_CLARITY_ID is genuinely unset. The
# lesson is the one this project keeps relearning: a local file is not evidence
# about production. See docs/05-search-console-and-analytics.md.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase. Public content (blog posts, portfolio items, testimonials) is read
# with the anon key at build/revalidate time. If these are placeholders, the
# blog builds EMPTY and the build guard in app/blog/page.tsx throws.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL connection string (Neon in production). Used by Prisma for the
# contact_message table only; everything else is Supabase.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ char random secret. Signs the review-invite tokens in lib/reviewToken.ts,
# which falls back to a known dev string if this is unset — never ship without it.
JWT_SECRET=

# Admin login (the user is auto-created from these on first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canonical origin, no trailing slash. Production serves www: skilloura.com
# 308-redirects to www.skilloura.com. Everything derives from this — canonical
# tags, JSON-LD @id values, sitemap URLs and the links in notification emails.
NEXT_PUBLIC_SITE_URL=https://www.skilloura.com

# WhatsApp number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Search & analytics (optional, but all three were silently off) ──────────

# Google Search Console HTML-tag verification. Without it, app/layout.tsx
# emits no verification meta tag and the property cannot be verified that way.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). components/SiteAnalytics.tsx
# only loads gtag when this is set, so conversion events go nowhere without it.
# Production uses G-MG1D7H2P6R. There is a second, empty property in the same
# Google account belonging to an unrelated site — using that one would point
# the site at the wrong property and cut the history.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID — session recordings and heatmaps. Optional.
NEXT_PUBLIC_CLARITY_ID=

# ── Notifications (optional; without these, emails only log to console) ────

# Real email delivery (free tier at resend.com)
# RESEND_API_KEY=
# EMAIL_FROM="Skilloura <onboarding@resend.dev>"

# Owner ping on a new lead — CallMeBot for WhatsApp, or Telegram
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Storage & AI (optional) ────────────────────────────────────────────────

# Vercel Blob storage for client file uploads (auto-set on Vercel)
# BLOB_READ_WRITE_TOKEN=

# Enables AI summary + quote drafts in the admin dashboard
# ANTHROPIC_API_KEY=

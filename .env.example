# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon in production)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ char random secret for admin session JWTs
JWT_SECRET=

# Admin login (user is auto-created from these on first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site config
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://example.com

# Vercel Blob storage for client file uploads (auto-set on Vercel)
# BLOB_READ_WRITE_TOKEN=

# Optional: enables AI summary + quote drafts in admin (console.anthropic.com)
# ANTHROPIC_API_KEY=

# Optional: enables real email notifications (free at resend.com)
# RESEND_API_KEY=
# EMAIL_FROM="Skilloura <onboarding@resend.dev>"

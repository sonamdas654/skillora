// Skilloura database — Neon Postgres, used only for the /contact "message
// us" inbox now. Leads/projects/quotes/payments/files/portfolio/testimonials
// /blog/client-portal all moved to Supabase (see supabase/*.sql).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

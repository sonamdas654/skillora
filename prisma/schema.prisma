// Skilloura database — plan section 26. PostgreSQL (Neon) in production;
// point DATABASE_URL at the Neon connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("admin") // super_admin | admin | sales | developer | client
  status       String    @default("active")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  notes        Note[]
}

model Service {
  id            String           @id @default(cuid())
  serviceName   String
  slug          String           @unique
  category      String
  description   String
  startingPrice String
  timeline      String
  status        String           @default("active")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  packages      ServicePackage[]
}

model ServicePackage {
  id            String  @id @default(cuid())
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id])
  packageName   String
  price         String
  features      String // JSON array
  revisionCount String?
  deliveryTime  String?
  status        String  @default("active")
}

model Lead {
  id                    String         @id @default(cuid())
  clientName            String
  email                 String
  phone                 String
  businessName          String?
  cityCountry           String?
  serviceCategory       String
  serviceType           String?
  projectDescription    String
  budgetRange           String
  deadline              String?
  projectStatus         String? // Just exploring | Need quotation | Ready to start | ...
  leadStatus            String         @default("New") // New | Reviewed | Contacted | Qualified | Quoted | Waiting for Payment | In Progress | Revision | Delivered | Closed | Rejected | Spam
  leadScore             String         @default("Medium") // High | Medium | Low
  source                String?
  preferredContact      String?
  bestTimeToContact     String?
  readyToStart          String?
  advancePaymentComfort String?
  additionalNotes       String?
  hasDomain             String?
  hasHosting            String?
  needsMaintenance      String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  formAnswers           FormAnswer[]
  uploadedFiles         UploadedFile[]
  quotations            Quotation[]
  invoices              Invoice[]
  payments              Payment[]
  projects              Project[]
  notes                 Note[]
  followups             Followup[]
}

model FormAnswer {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fieldKey  String
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model UploadedFile {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fileName       String
  storedFileName String
  fileType       String
  fileSize       Int
  fileUrl        String
  blobUrl        String? // Vercel Blob URL when cloud storage is active
  uploadedAt     DateTime @default(now())
}

model Quotation {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  quoteNumber String   @unique
  quoteAmount Float
  scope       String
  timeline    String?
  validUntil  DateTime?
  status      String   @default("Draft") // Draft | Sent | Accepted | Rejected | Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id])
  invoiceNumber String    @unique
  totalAmount   Float
  paidAmount    Float     @default(0)
  balanceAmount Float
  invoicePdfUrl String?
  status        String    @default("Draft") // Draft | Sent | Partially Paid | Paid | Overdue | Cancelled
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentType   String? // advance | milestone | final
  paymentStatus String   @default("Pending")
  transactionId String?
  paymentDate   DateTime?
  createdAt     DateTime @default(now())
}

model Project {
  id                   String    @id @default(cuid())
  leadId               String
  lead                 Lead      @relation(fields: [leadId], references: [id])
  projectName          String
  serviceType          String?
  status               String    @default("Requirement received")
  startDate            DateTime?
  expectedDeliveryDate DateTime?
  finalDeliveryDate    DateTime?
  assignedTo           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  note      String
  createdAt DateTime @default(now())
}

model Followup {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followupDate DateTime
  followupType String? // call | whatsapp | email
  message      String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
}

model Portfolio {
  id             String   @id @default(cuid())
  projectTitle   String
  industry       String
  category       String
  problem        String
  solution       String
  features       String? // JSON array
  imageUrl       String?
  demoLink       String?
  technologyUsed String?
  isDemo         Boolean  @default(true) // true = demo concept, shown honestly
  status         String   @default("active")
  createdAt      DateTime @default(now())
}

model Testimonial {
  id             String   @id @default(cuid())
  clientName     String
  clientBusiness String?
  rating         Int
  review         String
  status         String   @default("pending") // only real, verified reviews go active
  inviteToken    String?  @unique // jti of the review-invite link that created this (one review per link)
  createdAt      DateTime @default(now())
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  metaTitle       String?
  metaDescription String?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One-time login codes for the client portal. Only emails that already
// exist on a Lead can request a code; codes are stored hashed.
model ClientOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}
